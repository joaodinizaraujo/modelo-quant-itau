# Copie para .env e preencha.

# Token de usuario da Threads Graph API.
# Gere em https://developers.facebook.com/apps -> seu app -> Threads -> Use cases
THREADS_ACCESS_TOKEN=

# Opcional: doc_id do endpoint GraphQL web (usado apenas pelo backend nao-oficial).
# A Meta rotaciona esse id periodicamente; sobrescreva aqui quando o padrao parar de funcionar.
# THREADS_WEB_DOC_ID=
